# sensor-system/bridge — copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Serial port where Arduino is connected:
#   macOS / Linux: /dev/tty.usbmodem14101  or  /dev/ttyACM0
#   Windows:       COM3
SERIAL_PORT=/dev/tty.usbmodem14101
BAUDRATE=9600
READ_TIMEOUT=1

# phantom-backend WebSocket URL (on the same machine, usually localhost)
WS_URL=ws://localhost:8000/ws/device

# Must match DEVICE_TOKEN in phantom-backend/.env
DEVICE_TOKEN=phantom-bridge-secret

# Sampling rate and retry delays
SAMPLE_HZ=50
SERIAL_RETRY_SEC=2
WS_RETRY_SEC=3
