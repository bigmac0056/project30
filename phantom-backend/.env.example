# phantom-backend — copy to .env and fill in real values
# ─────────────────────────────────────────────────────

# JWT signing key — change this before deploying!
SECRET_KEY=phantom-emg-secret-key-change-in-production

# Token validity
TOKEN_DAYS=30

# Must match DEVICE_TOKEN in sensor-system/bridge/.env
DEVICE_TOKEN=phantom-bridge-secret

# SQLite (default) or a real database URL
DATABASE_URL=sqlite:///./phantom.db

# CORS — use * for dev, or comma-separated origins for prod
# e.g. ALLOWED_ORIGINS=http://192.168.1.42:5173,http://localhost:5173
ALLOWED_ORIGINS=*
