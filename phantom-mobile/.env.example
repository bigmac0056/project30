# phantom-mobile — copy to .env and set your bridge laptop's LAN IP.
# Both the phone and the laptop must be on the SAME Wi-Fi network.
#
# Finding the laptop IP:
#   macOS/Linux : hostname -I  OR  ifconfig en0 | grep "inet "
#   Windows     : ipconfig | findstr "IPv4"

# Replace 192.168.1.x with your actual bridge laptop IP
EXPO_PUBLIC_API_URL=http://192.168.1.x:8000
EXPO_PUBLIC_WS_URL=ws://192.168.1.x:8000/ws/client
